# Main domain
getchainlens.com {
    # API routes (Go backend)
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Health check
    handle /health {
        reverse_proxy backend:3001
    }

    # Static files from public folder
    handle /robots.txt {
        root * /srv/public
        file_server
    }
    handle /sitemap.xml {
        root * /srv/public
        file_server
    }
    handle /logo.svg {
        root * /srv/public
        file_server
    }
    handle /favicon.ico {
        root * /srv/public
        file_server
    }
    handle /favicon.svg {
        root * /srv/public
        file_server
    }
    handle /favicon-96x96.png {
        root * /srv/public
        file_server
    }
    handle /apple-touch-icon.png {
        root * /srv/public
        file_server
    }
    handle /site.webmanifest {
        root * /srv/public
        file_server
    }
    handle /web-app-manifest-192x192.png {
        root * /srv/public
        file_server
    }
    handle /web-app-manifest-512x512.png {
        root * /srv/public
        file_server
    }

    # Frontend (default)
    reverse_proxy frontend:3000

    # Logging
    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    # Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # XSS protection
        X-Frame-Options "SAMEORIGIN"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy
        Permissions-Policy "geolocation=(), microphone=(), camera=()"

        # Remove server header
        -Server
    }

    # Compression
    encode gzip zstd

    # Cache static assets
    @static {
        path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.webp *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}

# Redirect www to non-www
www.getchainlens.com {
    redir https://getchainlens.com{uri} permanent
}
